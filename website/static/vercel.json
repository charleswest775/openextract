{
  "cleanUrls": true,
  "proxy": {
    "entrypoint": "download-counter.ts"
  },
  "redirects": [
    {
      "source": "/download/mac",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.7.0/OpenExtract-0.7.0-arm64.dmg",
      "permanent": false
    },
    {
      "source": "/download/windows",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.7.0/OpenExtract-Setup-0.7.0.exe",
      "permanent": false
    },
    {
      "source": "/download/linux",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.7.0/openextract_0.7.0_amd64.deb",
      "permanent": false
    },
    {
      "source": "/download/linux-appimage",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.7.0/OpenExtract-0.7.0.AppImage",
      "permanent": false
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "openextract.app"
        }
      ],
      "destination": "https://www.openextract.app/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "charleswest775-openextract.vercel.app"
        }
      ],
      "destination": "https://www.openextract.app/:path",
      "permanent": true
    }
  ]
}
