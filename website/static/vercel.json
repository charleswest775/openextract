{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/download/mac/file",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.8.1/OpenExtract-0.8.1-arm64.dmg",
      "permanent": false
    },
    {
      "source": "/download/windows/file",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.8.1/OpenExtract-Setup-0.8.1.exe",
      "permanent": false
    },
    {
      "source": "/download/linux/file",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.8.1/openextract_0.8.1_amd64.deb",
      "permanent": false
    },
    {
      "source": "/download/linux-appimage/file",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.8.1/OpenExtract-0.8.1.AppImage",
      "permanent": false
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "openextract.app"
        }
      ],
      "destination": "https://www.openextract.app/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "charleswest775-openextract.vercel.app"
        }
      ],
      "destination": "https://www.openextract.app/:path",
      "permanent": true
    }
  ]
}
