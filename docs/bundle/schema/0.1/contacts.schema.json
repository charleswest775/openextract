{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/charleswest775/openextract/main/docs/bundle/schema/0.1/contacts.schema.json",
  "title": "OpenExtract Bundle contacts",
  "description": "contacts.json: the address book.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1",
      "description": "The format version this file follows."
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "integer",
              "string"
            ],
            "description": "The card's id in the address book; people.json refers to it."
          },
          "first_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "organization": {
            "type": [
              "string",
              "null"
            ]
          },
          "phones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "emails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "first_name",
          "last_name",
          "display_name",
          "organization",
          "phones",
          "emails",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "contacts"
  ],
  "additionalProperties": false
}
