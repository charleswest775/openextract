{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/img/screens/overview-:file",
      "destination": "/img/screens/home-:file",
      "permanent": true
    },
    {
      "source": "/img/screens/contacts-:file",
      "destination": "/img/screens/address-book-:file",
      "permanent": true
    },
    {
      "source": "/img/screens/history-:file",
      "destination": "/img/screens/web-history-:file",
      "permanent": true
    },
    {
      "source": "/support/pay",
      "destination": "https://buy.stripe.com/7sY00j9Es3vw0Ad16Q2wU01",
      "permanent": false
    },
    {
      "source": "/support/pay/5",
      "destination": "https://buy.stripe.com/7sY00j9Es3vw0Ad16Q2wU01",
      "permanent": false
    },
    {
      "source": "/support/pay/25",
      "destination": "https://buy.stripe.com/28E00jdUId66er3dTC2wU02",
      "permanent": false
    },
    {
      "source": "/support/pay/100",
      "destination": "https://buy.stripe.com/dRmcN58Aogii3Mp16Q2wU03",
      "permanent": false
    },
    {
      "source": "/support/pay/case",
      "destination": "https://buy.stripe.com/8x26oHcQEeaaer32aU2wU04",
      "permanent": false
    },
    {
      "source": "/support/pay/year",
      "destination": "https://buy.stripe.com/5kQ28r8Ao0jk3Mp5n62wU05",
      "permanent": false
    },
    {
      "source": "/download/mac/file",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.15.1/OpenExtract-0.15.1-arm64.dmg",
      "permanent": false
    },
    {
      "source": "/download/windows/file",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.15.1/OpenExtract-Setup-0.15.1.exe",
      "permanent": false
    },
    {
      "source": "/download/linux/file",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.15.1/openextract_0.15.1_amd64.deb",
      "permanent": false
    },
    {
      "source": "/download/linux-appimage/file",
      "destination": "https://github.com/charleswest775/openextract/releases/download/v0.15.1/OpenExtract-0.15.1.AppImage",
      "permanent": false
    },
    {
      "source": "/for/legal",
      "destination": "/use-cases/print-text-messages-for-court",
      "statusCode": 301
    },
    {
      "source": "/for/personal",
      "destination": "/use-cases/export-iphone-data",
      "statusCode": 301
    },
    {
      "source": "/for/investigators",
      "destination": "/use-cases/free-iphone-backup-viewer",
      "statusCode": 301
    },
    {
      "source": "/what-you-can-recover",
      "destination": "/blog/what-is-in-an-iphone-backup",
      "statusCode": 301
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "openextract.app"
        }
      ],
      "destination": "https://www.openextract.app/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "charleswest775-openextract.vercel.app"
        }
      ],
      "destination": "https://www.openextract.app/:path",
      "permanent": true
    }
  ]
