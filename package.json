{
  "name": "openextract",
  "version": "0.15.1",
  "description": "Free, open-source iPhone backup extractor",
  "main": "dist-electron/main.js",
  "author": "OpenExtract Contributors",
  "homepage": "https://www.openextract.app",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json && wait-on http://127.0.0.1:5179 && electron .\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/e2e/run.mjs --backups e2e-backups.json",
    "package": "npm run build && electron-builder",
    "python:install": "cd python && ../.venv/Scripts/pip install -r requirements.txt",
    "python:install:dev": "cd python && ../.venv/Scripts/pip install -r requirements-dev.txt",
    "python:lint": ".venv/Scripts/ruff check python/",
    "python:test": ".venv/Scripts/pytest python/tests/ -v",
    "python:bundle": "node scripts/bundle-engine.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/geist": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "benz-amr-recorder": "^1.1.5",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.10",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.1.0",
    "electron-builder": "26.12.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.openextract.app",
    "productName": "OpenExtract",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*.js"
    ],
    "extraResources": [
      {
        "from": "python/dist/openextract-engine",
        "to": "python"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "charleswest775",
      "repo": "openextract",
      "releaseType": "release"
    },
    "afterPack": "build/sign-windows.js",
    "afterSign": "build/notarize.js",
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis",
      "azureSignOptions": {
        "publisherName": "Charles West",
        "endpoint": "https://eus.codesigning.azure.net/",
        "certificateProfileName": "openextract",
        "codeSigningAccountName": "openextract-signing"
      }
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "OpenExtract Contributors <security@openextract.app>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2"
      ]
    }
  }
}
