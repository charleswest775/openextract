{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "openextract-renderer",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite"
      ],
      "port": 5179
    },
    {
      "name": "openextract-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5180"
      ],
      "port": 5180
    },
    {
      "name": "openextract-renderer-any-port",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx vite --port \"$PORT\" --strictPort"
      ],
      "autoPort": true,
      "port": 5179
    }
  ]
}
